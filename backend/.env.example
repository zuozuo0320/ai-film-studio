# 复制为 .env 后填入真实 key。不填则自动运行在 Mock 模式（占位图 + ffmpeg 假视频）。

# 强制 Mock（即使填了 key 也走假数据，便于演示）
FORCE_MOCK=false

# ---- OpenAI：剧本拆解(LLM) + GPT 出图(gpt-image-1) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# ---- 可灵 Kling：图生视频 ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
# 可灵模型名（如可灵 3.0 对应的官方 model_name）
KLING_MODEL=kling-v2-master
KLING_MODE=std
VIDEO_DURATION=5

# 前端开发地址（CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
